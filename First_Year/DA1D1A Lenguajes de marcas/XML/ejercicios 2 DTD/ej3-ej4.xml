    <!ELEMENT email (#PCDATA)>
    <!ELEMENT urlLinkedin (#PCDATA)>
<!ELEMENT descripcion-general (#PCDATA)>
<!ELEMENT skills (skill*)>
    <!ELEMENT skill (#PCDATA)>
	    <!ATTLIST skill nivel CDATA #REQUIRED>
<!ELEMENT formaciones-academicas (formacion-academica*)>
    <!ELEMENT formacion-academica (titulacion, centro-formacion)>
        <!ATTLIST formacion-academica anio-titulacion CDATA #REQUIRED>
        <!ELEMENT titulacion (#PCDATA)>
        <!ELEMENT centro-formacion (#PCDATA)>
<!ELEMENT experiencias-laborales (experiencia-laboral*)>
    <!ELEMENT experiencia-laboral (puesto, empresa, duracion)>
        <!ELEMENT puesto (#PCDATA)>
        <!ELEMENT empresa (#PCDATA)>
        <!ELEMENT duracion (mes-anio-inicio, mes-anio-fin)>
            <!ELEMENT mes-anio-inicio (#PCDATA)>
            <!ELEMENT mes-anio-fin (#PCDATA)>
]>
