<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE curriculum[
<!ELEMENT curriculum (nombre, 
                    apellido, 
                    anio_nacimiento, 
                    residencia, 
                    datos-contacto, 
                    descripcion-general, 
                    skills, 
                    formaciones-academicas, 
                    experiencias-laborales)>
<!ELEMENT nombre (#PCDATA)>
<!ELEMENT apellido (#PCDATA)>
<!ELEMENT anio_nacimiento (#PCDATA)>
<!ELEMENT residencia (ciudad, pais)>
    <!ELEMENT ciudad (#PCDATA)>
    <!ELEMENT pais (#PCDATA)>
<!ELEMENT datos-contacto (telefono*, email*, urlLinkedin)>
